# Ollama configuration — copy this to .env and adjust as needed

# URL where Ollama is running (default: localhost)
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Model to use — must be pulled first: ollama pull llama3.2
# Other good options: llama3.1, mistral, mixtral, llama3.2:1b (faster/lighter)
VITE_OLLAMA_MODEL=llama3.2
